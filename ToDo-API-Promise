<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToDo List</title>
     <!-- bootstrap    -->
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
            <center>
                <h1>ToDO LIST</h1>
                <table class="border border-3 border-primary">
                    <thead>
                        <tr>
                            <th class="border border-3 border-primary">userId</th>
                            <th class="border border-3 border-primary">Id</th>
                            <th class="border border-3 border-primary">Title</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody id="result">

                    </tbody>
                </table>
            </center>

</body>
<script>
         //1 Fetch() Asynchronous event response -> .then

         fetch('https://jsonplaceholder.typicode.com/todos').then(data=>data.json()).then(todos=>displayData(todos)).catch(err=>console.log(err));

         //2 Display content in HTML
         function displayData(todos){
            htmlData=``
            for(let todo of todos){
                
                htmlData = `<tr>
                            <th class="border border-3 border-primary">${todo.userId}</th>
                            <th class="border border-3 border-primary">${todo.id}</th>
                            <th class="border border-3 border-primary">${todo.title}</th>
                            <th class="border border-3 border-primary">${todo.completed}</th>
                            </tr>
                `

                result.innerHTML += htmlData;
                
            }
            
        }
         


</script>
</html>

